#include "gpu_ops.hpp"

#include "../../utils.hpp"

#include <cublas_v2.h>
#include <cuda_fp16.h>
#include <cuda_runtime.h>

#include <cmath>
#include <cstdint>
#include <stdexcept>
#include <string>

namespace {

void checkCuda(cudaError_t status, const char *operation) {
    if (status != cudaSuccess) {
        throw std::runtime_error(std::string(operation) + ": " + cudaGetErrorString(status));
    }
}

void checkCublas(cublasStatus_t status, const char *operation) {
    if (status != CUBLAS_STATUS_SUCCESS) {
        throw std::runtime_error(std::string(operation) + " failed with status "
                                 + std::to_string(static_cast<int>(status)));
    }
}

template <int Kind>
__device__ float read_value(const void *ptr, size_t index);

template <>
__device__ float read_value<0>(const void *ptr, size_t index) {
    return static_cast<const float *>(ptr)[index];
}

template <>
__device__ float read_value<1>(const void *ptr, size_t index) {
    const uint16_t bits = static_cast<const uint16_t *>(ptr)[index];
    __half_raw raw;
    raw.x = bits;
    return __half2float(raw);
}

template <>
__device__ float read_value<2>(const void *ptr, size_t index) {
    union {
        uint32_t bits;
        float value;
    } converted;
    converted.bits = static_cast<uint32_t>(static_cast<const uint16_t *>(ptr)[index]) << 16;
    return converted.value;
}

template <int Kind>
__device__ void write_value(void *ptr, size_t index, float value);

template <>
__device__ void write_value<0>(void *ptr, size_t index, float value) {
    static_cast<float *>(ptr)[index] = value;
}

template <>
__device__ void write_value<1>(void *ptr, size_t index, float value) {
    const __half converted = __float2half_rn(value);
    static_cast<uint16_t *>(ptr)[index] = reinterpret_cast<const __half_raw &>(converted).x;
}

template <>
__device__ void write_value<2>(void *ptr, size_t index, float value) {
    union {
        float value;
        uint32_t bits;
    } converted;
    converted.value = value;
    const uint32_t lsb = (converted.bits >> 16) & 1U;
    converted.bits += 0x7fffU + lsb;
    static_cast<uint16_t *>(ptr)[index] = static_cast<uint16_t>(converted.bits >> 16);
}

template <int Kind>
__global__ void add_kernel(void *out, const void *a, const void *b, size_t n) {
    const size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i < n) {
        write_value<Kind>(out, i, read_value<Kind>(a, i) + read_value<Kind>(b, i));
    }
}

template <int Kind>
__global__ void swiglu_kernel(void *out, const void *gate, const void *up, size_t n) {
    const size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i < n) {
        const float g = read_value<Kind>(gate, i);
        const float u = read_value<Kind>(up, i);
        write_value<Kind>(out, i, u * g / (1.0f + expf(-g)));
    }
}

template <int Kind>
__global__ void embedding_kernel(void *out, const int64_t *index, const void *weight,
                                 size_t count, size_t vocab_size, size_t hidden) {
    const size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    const size_t n = count * hidden;
    if (i < n) {
        const size_t row = i / hidden;
        const int64_t source_row = index[row];
        if (source_row >= 0 && static_cast<size_t>(source_row) < vocab_size) {
            write_value<Kind>(out, i,
                              read_value<Kind>(weight, static_cast<size_t>(source_row) * hidden
                                                           + i % hidden));
        }
    }
}

template <int Kind>
__global__ void bias_kernel(void *out, const void *bias, size_t n, size_t columns) {
    const size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i < n) {
        write_value<Kind>(out, i,
                          read_value<Kind>(out, i) + read_value<Kind>(bias, i % columns));
    }
}

template <int Kind>
__global__ void rms_norm_kernel(void *out, const void *in, const void *weight,
                                size_t hidden, float eps) {
    extern __shared__ float partial[];
    const size_t row = blockIdx.x;
    float sum = 0.0f;
    for (size_t col = threadIdx.x; col < hidden; col += blockDim.x) {
        const float value = read_value<Kind>(in, row * hidden + col);
        sum += value * value;
    }
    partial[threadIdx.x] = sum;
    __syncthreads();
    for (unsigned int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (threadIdx.x < stride) {
            partial[threadIdx.x] += partial[threadIdx.x + stride];
        }
        __syncthreads();
    }
    const float factor = rsqrtf(partial[0] / static_cast<float>(hidden) + eps);
    for (size_t col = threadIdx.x; col < hidden; col += blockDim.x) {
        write_value<Kind>(out, row * hidden + col,
                          read_value<Kind>(in, row * hidden + col) * factor
                              * read_value<Kind>(weight, col));
    }
}

template <int Kind>
__global__ void rope_kernel(void *out, const void *in, const int64_t *positions,
                            size_t heads, size_t head_dim, float theta, size_t n_pairs) {
    const size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (i >= n_pairs) {
        return;
    }
    const size_t half = head_dim / 2;
    const size_t frequency = i % half;
    const size_t token_head = i / half;
    const size_t token = token_head / heads;
    const size_t base = token_head * head_dim;
    const float exponent = 2.0f * static_cast<float>(frequency) / static_cast<float>(head_dim);
    const float angle = static_cast<float>(positions[token]) / powf(theta, exponent);
    const float sine = sinf(angle);
    const float cosine = cosf(angle);
    const float a = read_value<Kind>(in, base + frequency);
    const float b = read_value<Kind>(in, base + half + frequency);
    write_value<Kind>(out, base + frequency, a * cosine - b * sine);
    write_value<Kind>(out, base + half + frequency, b * cosine + a * sine);
}

template <int Kind>
__global__ void argmax_kernel(int64_t *max_idx, void *max_val, const void *vals, size_t n) {
    extern __shared__ unsigned char scratch[];
    float *values = reinterpret_cast<float *>(scratch);
    int64_t *indices = reinterpret_cast<int64_t *>(values + blockDim.x);
    float best_value = -INFINITY;
    int64_t best_index = 0;
    for (size_t i = threadIdx.x; i < n; i += blockDim.x) {
        const float value = read_value<Kind>(vals, i);
        if (value > best_value || (value == best_value && static_cast<int64_t>(i) < best_index)) {
            best_value = value;
            best_index = static_cast<int64_t>(i);
        }
    }
    values[threadIdx.x] = best_value;
    indices[threadIdx.x] = best_index;
    __syncthreads();
    for (unsigned int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (threadIdx.x < stride) {
            const float other = values[threadIdx.x + stride];
            const int64_t other_index = indices[threadIdx.x + stride];
            if (other > values[threadIdx.x]
                || (other == values[threadIdx.x] && other_index < indices[threadIdx.x])) {
                values[threadIdx.x] = other;
                indices[threadIdx.x] = other_index;
            }
        }
        __syncthreads();
    }
    if (threadIdx.x == 0) {
        *max_idx = indices[0];
        write_value<Kind>(max_val, 0, values[0]);
    }
}

template <int Kind>
__global__ void attention_kernel(void *out, const void *q, const void *k, const void *v,
                                 size_t query_length, size_t key_length,
                                 size_t query_heads, size_t key_value_heads,
                                 size_t head_dim, float scale) {
    extern __shared__ float scores[];
    const size_t query_pos = blockIdx.x / query_heads;
    const size_t query_head = blockIdx.x % query_heads;
    const size_t kv_head = query_head / (query_heads / key_value_heads);
    const size_t visible = key_length - query_length + query_pos + 1;
    const size_t query_base = (query_pos * query_heads + query_head) * head_dim;

    for (size_t key_pos = threadIdx.x; key_pos < visible; key_pos += blockDim.x) {
        const size_t key_base = (key_pos * key_value_heads + kv_head) * head_dim;
        float dot = 0.0f;
        for (size_t dim = 0; dim < head_dim; ++dim) {
            dot += read_value<Kind>(q, query_base + dim)
                 * read_value<Kind>(k, key_base + dim);
        }
        scores[key_pos] = dot * scale;
    }
    __syncthreads();

    if (threadIdx.x == 0) {
        float maximum = -INFINITY;
        for (size_t i = 0; i < visible; ++i) {
            maximum = fmaxf(maximum, scores[i]);
        }
        float denominator = 0.0f;
        for (size_t i = 0; i < visible; ++i) {
            scores[i] = expf(scores[i] - maximum);
            denominator += scores[i];
        }
        for (size_t i = 0; i < visible; ++i) {
            scores[i] /= denominator;
        }
    }
    __syncthreads();

    for (size_t dim = threadIdx.x; dim < head_dim; dim += blockDim.x) {
        float result = 0.0f;
        for (size_t key_pos = 0; key_pos < visible; ++key_pos) {
            const size_t value_base = (key_pos * key_value_heads + kv_head) * head_dim;
            result += scores[key_pos] * read_value<Kind>(v, value_base + dim);
        }
        write_value<Kind>(out, query_base + dim, result);
    }
}

template <typename Launcher>
void dispatch_float_type(llaisysDataType_t type, Launcher launcher) {
    switch (type) {
    case LLAISYS_DTYPE_F32:
        launcher.template operator()<0>();
        return;
    case LLAISYS_DTYPE_F16:
        launcher.template operator()<1>();
        return;
    case LLAISYS_DTYPE_BF16:
        launcher.template operator()<2>();
        return;
    default:
        EXCEPTION_UNSUPPORTED_DATATYPE(type);
    }
}

constexpr unsigned int THREADS = 256;

} // namespace

namespace llaisys::ops::nvidia {

void add(std::byte *out, const std::byte *a, const std::byte *b,
         llaisysDataType_t type, size_t numel) {
    dispatch_float_type(type, [&]<int Kind>() {
        add_kernel<Kind><<<(numel + THREADS - 1) / THREADS, THREADS>>>(out, a, b, numel);
    });
    checkCuda(cudaGetLastError(), "add kernel");
}

void swiglu(std::byte *out, const std::byte *gate, const std::byte *up,
            llaisysDataType_t type, size_t numel) {
    dispatch_float_type(type, [&]<int Kind>() {
        swiglu_kernel<Kind><<<(numel + THREADS - 1) / THREADS, THREADS>>>(out, gate, up, numel);
    });
    checkCuda(cudaGetLastError(), "SwiGLU kernel");
}

void embedding(std::byte *out, const std::byte *index, const std::byte *weight,
               llaisysDataType_t type, size_t count, size_t vocab_size, size_t hidden_size) {
    const size_t n = count * hidden_size;
    dispatch_float_type(type, [&]<int Kind>() {
        embedding_kernel<Kind><<<(n + THREADS - 1) / THREADS, THREADS>>>(
            out, reinterpret_cast<const int64_t *>(index), weight, count, vocab_size, hidden_size);
    });
    checkCuda(cudaGetLastError(), "embedding kernel");
}

void argmax(std::byte *max_idx, std::byte *max_val, const std::byte *vals,
            llaisysDataType_t type, size_t numel) {
    const size_t shared = THREADS * (sizeof(float) + sizeof(int64_t));
    dispatch_float_type(type, [&]<int Kind>() {
        argmax_kernel<Kind><<<1, THREADS, shared>>>(reinterpret_cast<int64_t *>(max_idx),
                                                   max_val, vals, numel);
    });
    checkCuda(cudaGetLastError(), "argmax kernel");
}

void rms_norm(std::byte *out, const std::byte *in, const std::byte *weight,
              llaisysDataType_t type, size_t rows, size_t hidden_size, float eps) {
    dispatch_float_type(type, [&]<int Kind>() {
        rms_norm_kernel<Kind><<<rows, THREADS, THREADS * sizeof(float)>>>(
            out, in, weight, hidden_size, eps);
    });
    checkCuda(cudaGetLastError(), "RMS norm kernel");
}

void rope(std::byte *out, const std::byte *in, const std::byte *pos_ids,
          llaisysDataType_t type, size_t sequence, size_t heads,
          size_t head_dim, float theta) {
    const size_t pairs = sequence * heads * (head_dim / 2);
    dispatch_float_type(type, [&]<int Kind>() {
        rope_kernel<Kind><<<(pairs + THREADS - 1) / THREADS, THREADS>>>(
            out, in, reinterpret_cast<const int64_t *>(pos_ids), heads, head_dim, theta, pairs);
    });
    checkCuda(cudaGetLastError(), "RoPE kernel");
}

void self_attention(std::byte *out, const std::byte *q, const std::byte *k,
                    const std::byte *v, llaisysDataType_t type,
                    size_t query_length, size_t key_length,
                    size_t query_heads, size_t key_value_heads,
                    size_t head_dim, float scale) {
    const size_t blocks = query_length * query_heads;
    dispatch_float_type(type, [&]<int Kind>() {
        attention_kernel<Kind><<<blocks, THREADS, key_length * sizeof(float)>>>(
            out, q, k, v, query_length, key_length, query_heads,
            key_value_heads, head_dim, scale);
    });
    checkCuda(cudaGetLastError(), "self-attention kernel");
}

void linear(std::byte *out, const std::byte *in, const std::byte *weight,
            const std::byte *bias, llaisysDataType_t type, size_t rows,
            size_t out_features, size_t in_features) {
    cublasHandle_t handle = nullptr;
    checkCublas(cublasCreate(&handle), "cublasCreate");
    const float alpha = 1.0f;
    const float beta = 0.0f;
    cublasStatus_t status;
    if (type == LLAISYS_DTYPE_F32) {
        status = cublasSgemm(handle, CUBLAS_OP_T, CUBLAS_OP_N,
                            static_cast<int>(out_features), static_cast<int>(rows),
                            static_cast<int>(in_features), &alpha,
                            reinterpret_cast<const float *>(weight), static_cast<int>(in_features),
                            reinterpret_cast<const float *>(in), static_cast<int>(in_features),
                            &beta, reinterpret_cast<float *>(out), static_cast<int>(out_features));
    } else {
        const cudaDataType_t data_type = type == LLAISYS_DTYPE_F16 ? CUDA_R_16F : CUDA_R_16BF;
        status = cublasGemmEx(handle, CUBLAS_OP_T, CUBLAS_OP_N,
                              static_cast<int>(out_features), static_cast<int>(rows),
                              static_cast<int>(in_features), &alpha,
                              weight, data_type, static_cast<int>(in_features),
                              in, data_type, static_cast<int>(in_features),
                              &beta, out, data_type, static_cast<int>(out_features),
                              CUDA_R_32F, CUBLAS_GEMM_DEFAULT);
    }
    checkCublas(status, "linear GEMM");
    checkCublas(cublasDestroy(handle), "cublasDestroy");
    if (bias != nullptr) {
        const size_t n = rows * out_features;
        dispatch_float_type(type, [&]<int Kind>() {
            bias_kernel<Kind><<<(n + THREADS - 1) / THREADS, THREADS>>>(out, bias, n, out_features);
        });
        checkCuda(cudaGetLastError(), "linear bias kernel");
    }
}

} // namespace llaisys::ops::nvidia
